{
    "categories": [
        {
            "title": "🚀 Features",
            "labels": [
                "feature",
                "enhancement"
            ]
        },
        {
            "title": "🐛 Fixes",
            "labels": [
                "fix",
                "bug"
            ]
        },
        {
            "title": "🧹 Other changes",
            "labels": []
        }
    ],
    "pr_template": "- ${{TITLE}} (#${{NUMBER}})",
    "commit_template": "- ${{MESSAGE}}",
    "include_commits": true,
    "tag_resolver": {
        "method": "semver"
    }
}